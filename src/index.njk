---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: layouts/base.njk
subpath: ""
eleventyComputed:
  pageTitle: "{{ lang.t.title }}"
  pageDescription: "{{ lang.t.sub | striptags }}"
classicScripts: ["/assets/qrcode.js"]
scripts: ["/assets/rules.js"]
---
{#- The rules with nines (48 cards). The page itself is in _includes/rules.njk. -#}
{%- set t = lang.t -%}
{%- set nines = true -%}
{%- set variant = "" -%}
{%- set play = lang.path + "play/" -%}
{% include "rules.njk" %}
