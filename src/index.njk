---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}"
layout: layouts/base.njk
subpath: ""
eleventyComputed:
  pageTitle: "{{ lang.t.title }}"
  pageDescription: "{{ lang.t.sub | striptags }}"
classicScripts: ["/assets/qrcode.js"]
scripts: ["/assets/rules.js"]
---
{%- from "card.njk" import card, back, cardRow -%}
{%- set t = lang.t -%}
{#- Card letters differ by language: J/Q in English, B/D in German. -#}
{%- set J = t.ranks.J -%}{%- set Q = t.ranks.Q -%}{%- set K = t.ranks.K -%}{%- set A = t.ranks.A -%}

<header class="hero">
  <div class="wrap">
    {% include "langmenu.njk" %}
    <h1>{{ t.h1 | safe }}</h1>
    <p>{{ t.sub | safe }}</p>
    <div class="fan" aria-hidden="true">
      {{ card(Q, "♣") }}
      {{ card("10", "♥") }}
      {{ card(Q, "♣") }}
    </div>
    <div class="goal">
      <div class="goal-icon" aria-hidden="true">🎯</div>
      <p>{{ t.goal | safe }}</p>
    </div>
  </div>
</header>

<nav aria-label="{{ t.navLabel }}">
  <ul>
    <li><a href="#aufbau">{{ t.nSetup }}</a></li>
    <li><a href="#parteien">{{ t.nTeams }}</a></li>
    <li><a href="#truempfe">{{ t.nTrumps }}</a></li>
    <li><a href="#stich">{{ t.nTrick }}</a></li>
    <li><a href="#augen">{{ t.nCount }}</a></li>
    <li class="js-only"><a href="#ueben">{{ t.nPractice }}</a></li>
    <li><a href="#ansagen">{{ t.nCalls }}</a></li>
    <li><a href="#abrechnung">{{ t.nScore }}</a></li>
    <li><a href="#sonderspiele">{{ t.nSolo }}</a></li>
    <li><a href="#hausregeln">{{ t.nVariants }}</a></li>
    <li><a href="#strategie">{{ t.nStrategy }}</a></li>
    <li><a href="#spickzettel">{{ t.nCheat }}</a></li>
    <li><a href="#teilen">{{ t.nShare }}</a></li>
  </ul>
</nav>

<main class="wrap">

  <section id="aufbau">
    <h2>{{ t.setupH }}</h2>
    <p class="lead">{{ t.setupLead | safe }}</p>

    <h3 class="sub">{{ t.deckH }}</h3>
    <div class="deck" role="img" aria-label="{{ t.deckAlt }}">
      {%- for s in ["♣", "♠", "♥", "♦"] %}
      <div class="deckrow">{{ cardRow([["9", s], ["10", s], [J, s], [Q, s], [K, s], [A, s]], lang.dir, "xs") }}<span class="times">×2</span></div>
      {%- endfor %}
    </div>
    <p>{{ t.deckP | safe }}</p>
    <p class="note">{{ t.rankP | safe }}</p>

    <h3 class="sub">{{ t.dealH }}</h3>
    <p>{{ t.dealP | safe }}</p>
  </section>

  <section id="parteien">
    <h2>{{ t.teamH }}</h2>
    <p class="lead">{{ t.teamLead | safe }}</p>
    <div class="teams" role="img" aria-label="{{ t.teamAlt }}">
      <div class="team re">
        <div class="row">{{ card(Q, "♣", "sm") }}{{ card(Q, "♣", "sm") }}</div>
        <b>Re</b><small>{{ t.teamRe }}</small>
      </div>
      <div class="vs" aria-hidden="true">vs.</div>
      <div class="team kontra">
        <div class="row">{{ back("sm") }}{{ back("sm") }}</div>
        <b>Kontra</b><small>{{ t.teamKontra }}</small>
      </div>
    </div>
    <p>{{ t.teamP1 | safe }}</p>
    <p>{{ t.teamP2 | safe }}</p>
    <p>{{ t.teamP3 | safe }}</p>
  </section>

  <section id="truempfe">
    <h2>{{ t.trumpH }}</h2>
    <p class="lead">{{ t.trumpLead | safe }}</p>
    <div class="ranks" role="img" aria-label="{{ t.trumpAlt }}">
      {{ cardRow([["10","♥"],[Q,"♣"],[Q,"♠"],[Q,"♥"],[Q,"♦"],[J,"♣"],[J,"♠"],[J,"♥"],[J,"♦"],[A,"♦"],["10","♦"],[K,"♦"],["9","♦"]], lang.dir) }}
    </div>
    <div class="rankscale" aria-hidden="true"><span>{{ t.high }}</span><span>{{ t.low }}</span></div>
    <ol class="steps">
      <li><h3>{{ t.tr1h }}</h3><p>{{ t.tr1p | safe }}</p></li>
      <li><h3>{{ t.tr2h }}</h3><p>{{ t.tr2p | safe }}</p></li>
      <li><h3>{{ t.tr3h }}</h3><p>{{ t.tr3p | safe }}</p></li>
      <li><h3>{{ t.tr4h }}</h3><p>{{ t.tr4p | safe }}</p></li>
    </ol>
    <p class="warn">{{ t.trumpWarn | safe }}</p>

    <h3 class="sub">{{ t.plainH }}</h3>
    <p>{{ t.plainP | safe }}</p>
    <div class="plain" role="img" aria-label="{{ t.plainAlt }}">
      <div class="prow"><div class="row">{{ cardRow([[A,"♣"],["10","♣"],[K,"♣"],["9","♣"]], lang.dir, "xs") }}</div><span><b>{{ t.clubs }}</b>{{ t.plain8 }}</span></div>
      <div class="prow"><div class="row">{{ cardRow([[A,"♠"],["10","♠"],[K,"♠"],["9","♠"]], lang.dir, "xs") }}</div><span><b>{{ t.spades }}</b>{{ t.plain8 }}</span></div>
      <div class="prow"><div class="row">{{ cardRow([[A,"♥"],[K,"♥"],["9","♥"]], lang.dir, "xs") }}</div><span><b>{{ t.hearts }}</b>{{ t.plain6 | safe }}</span></div>
    </div>
  </section>

  <section id="stich">
    <h2>{{ t.trickH }}</h2>
    <p class="lead">{{ t.trickLead | safe }}</p>
    <div class="decide">
      <p class="dq">{{ t.dq }}</p>
      <p class="dqs">{{ t.dqs | safe }}</p>
      <div class="branches">
        <div class="br yes-br">
          <div class="bh">{{ t.byH }}</div>
          <p class="bp">{{ t.by1 | safe }}</p>
        </div>
        <div class="br no-br">
          <div class="bh">{{ t.bnH }}</div>
          <p class="bp">{{ t.bn1 | safe }}</p>
        </div>
      </div>
      <p class="dnext">{{ t.dnext | safe }}</p>
    </div>

    <h3 class="sub">{{ t.winH }}</h3>
    <ol class="steps">
      <li><p>{{ t.win1 | safe }}</p></li>
      <li><p>{{ t.win2 | safe }}</p></li>
      <li><p>{{ t.win3 | safe }}</p></li>
    </ol>

    <div class="wood trick" role="img" aria-label="{{ t.trickAlt }}">
      <div class="row">
        <div class="play">{{ card(A, "♠", "sm") }}<small>{{ t.tk1 }}</small></div>
        <div class="play">{{ card("10", "♠", "sm") }}<small>{{ t.tk2 }}</small></div>
        <div class="play">{{ card(J, "♦", "sm", "gold") }}<small>{{ t.tk3 }}</small></div>
        <div class="play">{{ card(K, "♠", "sm") }}<small>{{ t.tk4 }}</small></div>
      </div>
    </div>
    <p>{{ t.trickP | safe }}</p>
  </section>

  <section id="augen">
    <h2>{{ t.countH }}</h2>
    <p class="lead">{{ t.countLead | safe }}</p>
    <div class="values" role="img" aria-label="{{ t.valuesAlt }}">
      {%- for v in [[A, "♠", 11], ["10", "♥", 10], [K, "♣", 4], [Q, "♦", 3], [J, "♠", 2], ["9", "♥", 0]] %}
      <div class="value">{{ card(v[0], v[1], "xs", pip=false) }}<b>{{ v[2] }}</b></div>
      {%- endfor %}
    </div>
    <p>{{ t.countP | safe }}</p>
  </section>

  <section id="ueben" class="js-only">
    <h2>{{ t.qH }}</h2>
    <p class="lead">{{ t.qLead | safe }}</p>
    <div class="trainer" aria-live="polite">
      <div class="duel">
        <div><div id="ledCard"></div><div class="lbl">{{ t.qLed }}</div></div>
        <div><div id="myCard"></div><div class="lbl">{{ t.qMine }}</div></div>
      </div>
      <p class="q">{{ t.qQ }}</p>
      <div class="btns" id="btns">
        <button class="yes" data-a="1">{{ t.qYes }}</button>
        <button class="no" data-a="0">{{ t.qNo }}</button>
      </div>
      <div class="fb" id="fb"></div>
      <button class="next" id="next" hidden>{{ t.qNext }}</button>
      <div class="score" id="score"></div>
    </div>
    <script type="application/json" id="quiz-text">{{ t.quiz | dump | safe }}</script>
    <script type="application/json" id="quiz-ranks">{{ t.ranks | dump | safe }}</script>
  </section>

  <section id="ansagen">
    <h2>{{ t.callH }}</h2>
    <p class="lead">{{ t.callLead | safe }}</p>

    <h3 class="sub">{{ t.reH }}</h3>
    <p>{{ t.reP | safe }}</p>

    <h3 class="sub">{{ t.absH }}</h3>
    <p>{{ t.absP | safe }}</p>
    <table class="ladder">
      <thead><tr><th scope="col">{{ t.callCol }}</th><th scope="col">{{ t.meansCol }}</th><th scope="col">{{ t.untilCol }}</th></tr></thead>
      <tbody>
        {%- for i in range(1, 6) %}
        <tr><th scope="row">{{ t["a" + i + "c"] }}</th><td>{{ t["a" + i + "m"] | safe }}</td><td class="num">{{ t["a" + i + "u"] }}</td></tr>
        {%- endfor %}
      </tbody>
    </table>
    <p>{{ t.absNote | safe }}</p>
  </section>

  <section id="abrechnung">
    <h2>{{ t.scoreH }}</h2>
    <p class="lead">{{ t.scoreLead | safe }}</p>
    <table class="points">
      <tbody>
        {%- for i in range(1, 6) %}
        <tr><td class="num">{{ t["s" + i + "n"] }}</td><td>{{ t["s" + i] | safe }}</td></tr>
        {%- endfor %}
      </tbody>
    </table>

    <h3 class="sub">{{ t.extraH }}</h3>
    <p>{{ t.extraLead | safe }}</p>
    <div class="specials">
      <div class="sp">{{ card(A, "♦", "sm") }}<div><h3>{{ t.x1h }}</h3><p>{{ t.x1p | safe }}</p></div></div>
      <div class="sp">{{ card(J, "♣", "sm") }}<div><h3>{{ t.x2h }}</h3><p>{{ t.x2p | safe }}</p></div></div>
      <div class="sp">
        <div class="four">{{ card(A, "♠", "xs") }}{{ card(A, "♠", "xs") }}{{ card("10", "♣", "xs") }}{{ card("10", "♥", "xs") }}</div>
        <div><h3>{{ t.x3h }}</h3><p>{{ t.x3p | safe }}</p></div>
      </div>
    </div>

    <h3 class="sub">{{ t.payH }}</h3>
    <p>{{ t.payP | safe }}</p>
    <table class="points example">
      <caption>{{ t.exH }}</caption>
      <tbody>
        {%- for i in range(1, 5) %}
        <tr><td class="num">{{ t["ex" + i + "n"] }}</td><td>{{ t["ex" + i] | safe }}</td></tr>
        {%- endfor %}
      </tbody>
      <tfoot><tr><td class="num">{{ t.exSumN }}</td><td>{{ t.exSum | safe }}</td></tr></tfoot>
    </table>
  </section>

  <section id="sonderspiele">
    <h2>{{ t.specH }}</h2>
    <p class="lead">{{ t.specLead | safe }}</p>

    <h3 class="sub">{{ t.weddingH }}</h3>
    <p>{{ t.weddingP | safe }}</p>

    <h3 class="sub">{{ t.soloH }}</h3>
    <p>{{ t.soloP | safe }}</p>
    <div class="specials">
      <div class="sp">{{ card(Q, "♠", "sm") }}<div><h3>{{ t.so1h }}</h3><p>{{ t.so1p | safe }}</p></div></div>
      <div class="sp">{{ card(J, "♥", "sm") }}<div><h3>{{ t.so2h }}</h3><p>{{ t.so2p | safe }}</p></div></div>
      <div class="sp">{{ card(A, "♣", "sm") }}<div><h3>{{ t.so3h }}</h3><p>{{ t.so3p | safe }}</p></div></div>
      <div class="sp">{{ card("9", "♠", "sm") }}<div><h3>{{ t.so4h }}</h3><p>{{ t.so4p | safe }}</p></div></div>
    </div>
    <p>{{ t.soloScore | safe }}</p>
  </section>

  <section id="hausregeln">
    <h2>{{ t.varH }}</h2>
    <p class="lead">{{ t.varLead | safe }}</p>
    <ul class="strats">
      {%- for i in range(1, 7) %}
      <li><h3>{{ t["v" + i + "h"] }}</h3><p>{{ t["v" + i + "p"] | safe }}</p></li>
      {%- endfor %}
    </ul>
  </section>

  <section id="strategie">
    <h2>{{ t.stH }}</h2>
    <p class="lead">{{ t.stLead | safe }}</p>
    <ul class="strats">
      {%- for i in range(1, 8) %}
      <li><h3>{{ t["t" + i + "h"] }}</h3><p>{{ t["t" + i + "p"] | safe }}</p></li>
      {%- endfor %}
    </ul>
  </section>

  <section id="spickzettel">
    <div class="cheat">
      <h2>{{ t.chH }}</h2>
      <dl>
        {%- for i in range(1, 11) %}
        <dt>{{ t["c" + i + "t"] }}</dt><dd>{{ t["c" + i + "d"] | safe }}</dd>
        {%- endfor %}
      </dl>
    </div>
  </section>

  <section id="teilen">
    <div class="sharebox">
      <h2>{{ t.shH }}</h2>
      <p class="shlead">{{ t.shLead | safe }}</p>
      <div class="qr" id="qr" role="img" aria-label="{{ t.shAlt }}"></div>
      <p class="shurl"><a id="shurl" href="{{ lang.url }}">{{ lang.url | replace("https://", "") }}</a></p>
      <div class="shbtns js-only">
        <button type="button" class="shbtn primary" id="shShare" hidden>{{ t.shBtn }}</button>
        <button type="button" class="shbtn" id="shCopy" data-done="{{ t.shCopied }}">{{ t.shCopy }}</button>
      </div>
    </div>
  </section>
</main>

<footer>{{ t.foot | safe }}</footer>
